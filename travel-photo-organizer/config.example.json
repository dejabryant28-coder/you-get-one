{
  "root_folder_name": "Travel Photos",
  "logs_folder_name": "_Logs",
  "log_file_name": "photo-log.csv",
  "source_folder_candidates": [
    "/Pictures/Samsung Gallery/DCIM/Camera",
    "/Pictures/Samsung Gallery/Camera",
    "/Pictures/Camera Roll",
    "/Pictures/Camera imports"
  ],
  "test_mode": true,
  "max_photos_per_run": 5,
  "dry_run": false,
  "include_videos": true,
  "skip_name_patterns": [
    "screenshot",
    "-WA0"
  ],
  "unclear_location_km_threshold": 50,
  "big_city_population": 250000,
  "use_online_geocoding": true,
  "home_country": "United States",
  "append_place_to_copy_name": true
}
